	keywords = {*Computers, *Permeability, *Solubility, Adsorption, Chemical Phenomena, Chemistry, Physical, Pharmaceutical Preparations/*chemistry, Pharmacology/*instrumentation, Thermodynamics},
	pages = {3--26},
}

